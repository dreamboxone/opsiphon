#!/bin/sh
#
# SPDX-License-Identifier: GPL-3.0-only
# Copyright (C) 2026 dreamboxone <https://t.me/routekernel1>
# Part of opsiphon - Psiphon for OpenWrt - https://github.com/dreamboxone/opsiphon
#
# rpcd backend for luci-app-opsiphon (ubus object: luci.opsiphon)

. /usr/share/libubox/jshn.sh

STATE=/var/run/opsiphon/state
LOG=/var/log/opsiphon/notices.log
VERSION_CACHE=/var/run/opsiphon/core_version
CORE=/usr/bin/psiphon-tunnel-core

state_get() {
	sed -n "s/^$1=//p" "$STATE" 2>/dev/null | tail -1
}

num() {
	case "$1" in
		''|*[!0-9]*) echo 0 ;;
		*) echo "$1" ;;
	esac
}

core_version() {
	if [ ! -s "$VERSION_CACHE" ]; then
		mkdir -p /var/run/opsiphon
		if [ -x "$CORE" ]; then
			"$CORE" -v 2>&1 | tr -d '\r' | head -c 500 > "$VERSION_CACHE" 2>/dev/null
		fi
	fi
	# `-v` prints human readable lines: "  Revision: <rev>"
	sed -n 's/^[ 	]*Revision:[ 	]*//p' "$VERSION_CACHE" 2>/dev/null | head -1
}

is_running() {
	pgrep -f "$CORE" >/dev/null 2>&1
}

method_state() {
	local running=0 connected=0 tunnels enabled autostart

	is_running && running=1
	tunnels=$(num "$(state_get tunnels)")
	[ "$tunnels" -gt 0 ] && connected=1

	enabled=$(uci -q get opsiphon.config.enabled)
	[ -n "$enabled" ] || enabled=0
	[ "$enabled" = "1" ] && enabled=1 || enabled=0

	autostart=0
	/etc/init.d/opsiphon enabled >/dev/null 2>&1 && autostart=1

	json_init
	json_add_string "version" "1.0.2"
	json_add_string "core_rev" "$(core_version)"
	json_add_boolean "running" "$running"
	json_add_boolean "connected" "$connected"
	json_add_boolean "enabled" "$enabled"
	json_add_boolean "autostart" "$autostart"
	json_add_int "tunnels" "$tunnels"
	json_add_int "connected_since" "$(num "$(state_get connected_since)")"
	json_add_int "updated" "$(num "$(state_get updated)")"
	json_add_int "now" "$(date +%s)"
	json_add_int "sent" "$(num "$(state_get sent)")"
	json_add_int "received" "$(num "$(state_get received)")"
	json_add_int "socks_port" "$(num "$(state_get socks_port)")"
	json_add_int "http_port" "$(num "$(state_get http_port)")"
	json_add_string "server_region" "$(state_get server_region)"
	json_add_string "client_region" "$(state_get client_region)"
	json_add_string "homepage" "$(state_get homepage)"
	json_add_int "started" "$(num "$(state_get started)")"
	json_add_int "attempts" "$(num "$(state_get attempts)")"
	json_add_int "candidates" "$(state_get candidates | grep -E '^-?[0-9]+$' || echo -1)"
	json_add_boolean "serverlist" "$(num "$(state_get serverlist)")"
	json_add_string "last_warning" "$(state_get last_warning)"
	json_add_string "last_event" "$(state_get last_event)"
	json_add_string "last_message" "$(state_get last_message)"

	json_add_array "regions"
	local r
	for r in $(state_get regions | tr ',' ' '); do
		json_add_string "" "$r"
	done
	json_close_array

	json_dump
}

method_log() {
	local lines input
	read -r input
	[ -n "$input" ] || input='{}'
	json_load "$input" 2>/dev/null
	json_get_var lines lines
	case "$lines" in
		''|*[!0-9]*) lines=50 ;;
	esac

	json_init
	json_add_string "log" "$(tail -n "$lines" "$LOG" 2>/dev/null)"
	json_dump
}

# Run something without holding this request open. rpcd reads our stdout until
# every writer closes it, so a child that keeps it would hang the browser call
# no matter how fast we answer.
detach() {
	if command -v setsid >/dev/null 2>&1; then
		setsid "$@" </dev/null >/dev/null 2>&1 &
	else
		( "$@" </dev/null >/dev/null 2>&1 & ) &
	fi
	return 0
}

method_usage() {
	/usr/libexec/opsiphon-usage report 2>/dev/null || echo '{}'
}

method_passwall() {
	/usr/libexec/opsiphon-passwall status 2>/dev/null || echo '{"installed":0}'
}

method_rules() {
	/usr/libexec/opsiphon-rules status 2>/dev/null || echo '{}'
}

method_action() {
	local name input out rc=0
	read -r input
	[ -n "$input" ] || input='{}'
	json_load "$input" 2>/dev/null
	json_get_var name name

	case "$name" in
		start|connect)
			uci -q set opsiphon.config.enabled='1' && uci -q commit opsiphon
			detach /etc/init.d/opsiphon restart
			;;
		stop|disconnect)
			uci -q set opsiphon.config.enabled='0' && uci -q commit opsiphon
			detach /etc/init.d/opsiphon stop
			;;
		restart|reconnect)
			detach /etc/init.d/opsiphon restart
			;;
		pw_sync)
			out=$(/usr/libexec/opsiphon-passwall sync 2>&1) || rc=1
			;;
		pw_activate)
			out=$(/usr/libexec/opsiphon-passwall activate 2>&1) || rc=1
			;;
		pw_iran_on)
			out=$(/usr/libexec/opsiphon-passwall iran on 2>&1) || rc=1
			;;
		pw_iran_off)
			out=$(/usr/libexec/opsiphon-passwall iran off 2>&1) || rc=1
			;;
		pw_remove)
			out=$(/usr/libexec/opsiphon-passwall remove 2>&1) || rc=1
			;;
		rules_update)
			# downloading takes far longer than a browser request may last,
			# so it runs detached and reports through the rules status
			detach /usr/libexec/opsiphon-rules update
			out="download started"
			;;
		*)
			rc=1
			;;
	esac

	json_init
	json_add_boolean "ok" "$((1 - rc))"
	json_add_string "action" "$name"
	json_add_string "output" "$out"
	json_dump
}

case "$1" in
	list)
		json_init
		json_add_object "state"; json_close_object
		json_add_object "log"; json_add_int "lines" 50; json_close_object
		json_add_object "action"; json_add_string "name" "start"; json_close_object
		json_add_object "usage"; json_close_object
		json_add_object "passwall"; json_close_object
		json_add_object "rules"; json_close_object
		json_dump
		;;
	call)
		case "$2" in
			state)    method_state ;;
			log)      method_log ;;
			usage)    method_usage ;;
			passwall) method_passwall ;;
			rules)    method_rules ;;
			action)   method_action ;;
			*)      echo '{"error":"unknown method"}' ;;
		esac
		;;
esac
