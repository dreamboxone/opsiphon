#
# opsiphon-notices - consume psiphon-tunnel-core notice stream, keep live state
#
# Reads JSON notices on stdin, maintains /var/run/opsiphon/state (key=value)
# and a bounded human log in /var/log/opsiphon/notices.log. Nothing is written
# to flash, and the log can never grow without bound.

function sval(key,   re, s) {
	re = "\"" key "\"[ ]*:[ ]*\""
	if (match($0, re "[^\"]*\"")) {
		s = substr($0, RSTART, RLENGTH)
		sub(re, "", s)
		sub(/"$/, "", s)
		return s
	}
	return ""
}

function nval(key,   re, s) {
	re = "\"" key "\"[ ]*:[ ]*"
	if (match($0, re "-?[0-9]+")) {
		s = substr($0, RSTART, RLENGTH)
		sub(re, "", s)
		return s + 0
	}
	return -1
}

function aval(key,   re, s) {
	# extract a JSON string array as a comma separated list
	re = "\"" key "\"[ ]*:[ ]*\\["
	if (match($0, re "[^]]*\\]")) {
		s = substr($0, RSTART, RLENGTH)
		sub(re, "", s)
		sub(/\]$/, "", s)
		gsub(/["]/, "", s)
		gsub(/ /, "", s)
		return s
	}
	return ""
}

function write_state(   tmp) {
	tmp = state_file ".tmp"
	printf "" > tmp
	printf "updated=%d\n", systime() > tmp
	printf "tunnels=%d\n", tunnels > tmp
	printf "connected=%d\n", (tunnels > 0 ? 1 : 0) > tmp
	printf "connected_since=%d\n", connected_since > tmp
	printf "server_region=%s\n", server_region > tmp
	printf "client_region=%s\n", client_region > tmp
	printf "socks_port=%d\n", socks_port > tmp
	printf "http_port=%d\n", http_port > tmp
	printf "sent=%d\n", (total_sent > sent ? total_sent : sent) > tmp
	printf "received=%d\n", (total_received > received ? total_received : received) > tmp
	printf "regions=%s\n", regions > tmp
	printf "homepage=%s\n", homepage > tmp
	printf "last_event=%s\n", last_event > tmp
	printf "last_message=%s\n", last_message > tmp
	printf "started=%d\n", started > tmp
	printf "attempts=%d\n", attempts > tmp
	printf "candidates=%d\n", candidates > tmp
	printf "serverlist=%d\n", serverlist > tmp
	printf "last_warning=%s\n", last_warning > tmp
	close(tmp)
	system("mv " tmp " " state_file)
	last_write = systime()
	dirty = 0
}

function flush_usage(   ds, dr) {
	# hand the deltas since the last flush to the day accounting script;
	# at most once every few minutes, so this never touches flash in a loop
	ds = (total_sent > sent ? total_sent : sent) - flushed_sent
	dr = (total_received > received ? total_received : received) - flushed_recv
	if (ds <= 0 && dr <= 0) { last_flush = systime(); return }
	system("/usr/libexec/opsiphon-usage add " ds " " dr " >/dev/null 2>&1")
	flushed_sent += ds
	flushed_recv += dr
	last_flush = systime()
}

function shorten(m) {
	# Psiphon errors carry the whole internal call chain; keep the head (what
	# failed) and the tail (why) so the GUI stays readable
	if (length(m) <= 160) return m
	return substr(m, 1, 90) " … " substr(m, length(m) - 59)
}

# The reason a dial failed is the last link of the call chain psiphon traces
# through, e.g. ".../psiphon.tcpDial#312: dial tcp x: connect: connection
# refused" -> "connection refused".
function cause(msg,   n, parts) {
	n = split(msg, parts, ": ")
	return n > 0 ? parts[n] : msg
}

function logline(nt, msg) {
	# epoch timestamp - LuCI formats it for display, and this avoids relying
	# on strftime() being present in busybox awk
	printf "%d %s %s\n", systime(), nt, msg >> log_file
	fflush()
	log_lines++
	if (log_lines >= log_max) {
		close(log_file)
		system(": > " log_file)
		log_lines = 0
	}
}

# Per-attempt transport failures, and complaints about what a local client
# asked the proxy for. Psiphon emits one of these for every server and every
# obfuscation protocol it tries, so under filtering they arrive constantly and
# always win the "last message" slot - which is how a user ends up staring at
# "connection reset by peer" while the tunnel is simply still being built. The
# GUI already says how long it has been trying and over how many attempts, and
# every one of these still goes to the notice log for View notices.
function noisy(msg,   i, pats, n) {
	# Psiphon traces its errors through the call chain, so a failed attempt
	# arrives looking like
	#
	#   psiphon.GetTactics#166: psiphon.fetchTactics#298: psiphon.DialMeek#579:
	#   tlsdialer.Dial#699: EOF
	#
	# That "name#line:" shape only ever appears in an internal trace, and no
	# reader of this GUI can do anything with one. Treat it as internal
	# whatever the notice type says.
	if (msg ~ /[A-Za-z_)]#[0-9]+:/) return 1

	n = split("SOCKS proxy accept error" SUBSEP \
	          "HTTP proxy accept error" SUBSEP \
	          "meek round trip failed" SUBSEP \
	          "connection reset by peer" SUBSEP \
	          "i/o timeout" SUBSEP \
	          "context deadline exceeded" SUBSEP \
	          "tactics request failed", pats, SUBSEP)
	for (i = 1; i <= n; i++)
		if (index(msg, pats[i]) > 0) return 1
	return 0
}

BEGIN {
	state_dir  = "/var/run/opsiphon"
	state_file = state_dir "/state"
	log_file   = "/var/log/opsiphon/notices.log"
	log_max    = 400

	system("mkdir -p " state_dir " /var/log/opsiphon")

	tunnels = 0; connected_since = 0
	sent = 0; received = 0; total_sent = 0; total_received = 0
	socks_port = 0; http_port = 0
	server_region = ""; client_region = ""; regions = ""; homepage = ""
	last_event = "Starting"; last_message = ""; last_warning = ""
	started = systime(); attempts = 0; candidates = -1; serverlist = 0
	log_lines = 0; last_write = 0; dirty = 1
	flushed_sent = 0; flushed_recv = 0; last_flush = systime()
	usage_interval = 300
	write_state()
}

{
	nt = sval("noticeType")
	if (nt == "") next

	important = 0
	suppress = 0

	if (nt == "BytesTransferred") {
		v = nval("sent");     if (v > 0) sent += v
		v = nval("received"); if (v > 0) received += v
		dirty = 1
	} else if (nt == "TotalBytesTransferred") {
		v = nval("sent");     if (v >= 0) total_sent = v
		v = nval("received"); if (v >= 0) total_received = v
		dirty = 1
	} else if (nt == "Tunnels") {
		v = nval("count")
		if (v >= 0) {
			tunnels = v
			if (v > 0 && connected_since == 0) connected_since = systime()
			if (v == 0) connected_since = 0
		}
		important = 1
		logline(nt, "count=" tunnels)
	} else if (nt == "ConnectedServerRegion") {
		server_region = sval("serverRegion")
		important = 1
		logline(nt, server_region)
	} else if (nt == "ClientRegion") {
		client_region = sval("region")
		important = 1
		logline(nt, client_region)
	} else if (nt == "ListeningSocksProxyPort") {
		socks_port = nval("port"); important = 1
		logline(nt, socks_port "")
	} else if (nt == "ListeningHttpProxyPort") {
		http_port = nval("port"); important = 1
		logline(nt, http_port "")
	} else if (nt == "AvailableEgressRegions") {
		regions = aval("regions"); important = 1
		logline(nt, regions)
	} else if (nt == "Homepage") {
		homepage = sval("url"); important = 1
		logline(nt, homepage)
	} else if (nt == "Exiting") {
		tunnels = 0; connected_since = 0; important = 1
		logline(nt, "")
	} else if (nt == "ConnectingServer") {
		attempts++
		dirty = 1
		logline(nt, sval("region") " " sval("protocol"))
	} else if (nt == "CandidateServers") {
		# how many servers psiphon actually has to try; 0 means the server
		# list was never obtained (bootstrap blocked)
		v = nval("count"); if (v >= 0) candidates = v
		important = 1
		logline(nt, "count=" candidates " region=" sval("region"))
	} else if (nt == "RemoteServerListResourceDownloaded") {
		serverlist = 1
		important = 1
		logline(nt, sval("url"))
	} else if (nt == "Alert" || nt == "Error" || nt == "Warning" || nt == "InternalError" || nt == "ServerAlert") {
		msg = shorten(sval("message") sval("reason"))
		if (noisy(msg)) {
			# keep whatever the last meaningful event was
			suppress = 1
			# Log the first one and then stop: a blocked network produces
			# hundreds of identical lines a minute, and 400 of them push
			# every real event out of the ring buffer.
			if (!(msg in seen_noisy)) {
				seen_noisy[msg] = 1
				logline(nt, msg " (further identical warnings not logged)")
			}
		} else {
			logline(nt, msg)
			last_message = msg
			last_warning = nt ": " msg
			important = 1
		}
	} else if (nt == "Info" || nt == "UserLog") {
		msg = sval("message")
		if (index(msg, "Memory metrics") == 1) {
			# heap counters, several per second - never useful here
		} else if (index(msg, "failed to connect") == 1) {
			# One per server tried, each carrying the whole call chain. The
			# reason is the last link of it, and that is the part worth
			# keeping: "connection refused" and "EOF" say very different
			# things about what is in the way.
			logline("Attempt failed", cause(msg))
		} else if (!noisy(msg)) {
			logline(nt, msg)
		}
	} else if (nt == "SocksProxyPortInUse" || nt == "HttpProxyPortInUse") {
		last_message = nt " " nval("port")
		important = 1
		logline(nt, nval("port") "")
	}

	if (!suppress) last_event = nt

	if (important || (dirty && systime() - last_write >= 2)) write_state()
	if (systime() - last_flush >= usage_interval) flush_usage()
}

END {
	flush_usage()
	tunnels = 0
	connected_since = 0
	attempts = 0
	last_event = "Stopped"
	write_state()
}
