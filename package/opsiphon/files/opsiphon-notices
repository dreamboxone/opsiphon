#
# opsiphon-notices - consume psiphon-tunnel-core notice stream, keep live state
#
# Reads JSON notices on stdin, maintains /var/run/opsiphon/state (key=value)
# and a bounded human log in /var/log/opsiphon/notices.log. Nothing is written
# to flash, and the log can never grow without bound.

function sval(key,   re, s) {
	re = "\"" key "\"[ ]*:[ ]*\""
	if (match($0, re "[^\"]*\"")) {
		s = substr($0, RSTART, RLENGTH)
		sub(re, "", s)
		sub(/"$/, "", s)
		return s
	}
	return ""
}

function nval(key,   re, s) {
	re = "\"" key "\"[ ]*:[ ]*"
	if (match($0, re "-?[0-9]+")) {
		s = substr($0, RSTART, RLENGTH)
		sub(re, "", s)
		return s + 0
	}
	return -1
}

function aval(key,   re, s) {
	# extract a JSON string array as a comma separated list
	re = "\"" key "\"[ ]*:[ ]*\\["
	if (match($0, re "[^]]*\\]")) {
		s = substr($0, RSTART, RLENGTH)
		sub(re, "", s)
		sub(/\]$/, "", s)
		gsub(/["]/, "", s)
		gsub(/ /, "", s)
		return s
	}
	return ""
}

function write_state(   tmp) {
	tmp = state_file ".tmp"
	printf "" > tmp
	printf "updated=%d\n", systime() > tmp
	printf "tunnels=%d\n", tunnels > tmp
	printf "connected=%d\n", (tunnels > 0 ? 1 : 0) > tmp
	printf "connected_since=%d\n", connected_since > tmp
	printf "server_region=%s\n", server_region > tmp
	printf "client_region=%s\n", client_region > tmp
	printf "socks_port=%d\n", socks_port > tmp
	printf "http_port=%d\n", http_port > tmp
	printf "sent=%d\n", (total_sent > sent ? total_sent : sent) > tmp
	printf "received=%d\n", (total_received > received ? total_received : received) > tmp
	printf "regions=%s\n", regions > tmp
	printf "homepage=%s\n", homepage > tmp
	printf "last_event=%s\n", last_event > tmp
	printf "last_message=%s\n", last_message > tmp
	printf "started=%d\n", started > tmp
	printf "attempts=%d\n", attempts > tmp
	printf "candidates=%d\n", candidates > tmp
	printf "serverlist=%d\n", serverlist > tmp
	printf "last_warning=%s\n", last_warning > tmp
	close(tmp)
	system("mv " tmp " " state_file)
	last_write = systime()
	dirty = 0
}

function shorten(m) {
	# Psiphon errors carry the whole internal call chain; keep the head (what
	# failed) and the tail (why) so the GUI stays readable
	if (length(m) <= 160) return m
	return substr(m, 1, 90) " … " substr(m, length(m) - 59)
}

function logline(nt, msg) {
	# epoch timestamp - LuCI formats it for display, and this avoids relying
	# on strftime() being present in busybox awk
	printf "%d %s %s\n", systime(), nt, msg >> log_file
	fflush()
	log_lines++
	if (log_lines >= log_max) {
		close(log_file)
		system(": > " log_file)
		log_lines = 0
	}
}

BEGIN {
	state_dir  = "/var/run/opsiphon"
	state_file = state_dir "/state"
	log_file   = "/var/log/opsiphon/notices.log"
	log_max    = 400

	system("mkdir -p " state_dir " /var/log/opsiphon")

	tunnels = 0; connected_since = 0
	sent = 0; received = 0; total_sent = 0; total_received = 0
	socks_port = 0; http_port = 0
	server_region = ""; client_region = ""; regions = ""; homepage = ""
	last_event = "Starting"; last_message = ""; last_warning = ""
	started = systime(); attempts = 0; candidates = -1; serverlist = 0
	log_lines = 0; last_write = 0; dirty = 1
	write_state()
}

{
	nt = sval("noticeType")
	if (nt == "") next

	important = 0

	if (nt == "BytesTransferred") {
		v = nval("sent");     if (v > 0) sent += v
		v = nval("received"); if (v > 0) received += v
		dirty = 1
	} else if (nt == "TotalBytesTransferred") {
		v = nval("sent");     if (v >= 0) total_sent = v
		v = nval("received"); if (v >= 0) total_received = v
		dirty = 1
	} else if (nt == "Tunnels") {
		v = nval("count")
		if (v >= 0) {
			tunnels = v
			if (v > 0 && connected_since == 0) connected_since = systime()
			if (v == 0) connected_since = 0
		}
		important = 1
		logline(nt, "count=" tunnels)
	} else if (nt == "ConnectedServerRegion") {
		server_region = sval("serverRegion")
		important = 1
		logline(nt, server_region)
	} else if (nt == "ClientRegion") {
		client_region = sval("region")
		important = 1
		logline(nt, client_region)
	} else if (nt == "ListeningSocksProxyPort") {
		socks_port = nval("port"); important = 1
		logline(nt, socks_port "")
	} else if (nt == "ListeningHttpProxyPort") {
		http_port = nval("port"); important = 1
		logline(nt, http_port "")
	} else if (nt == "AvailableEgressRegions") {
		regions = aval("regions"); important = 1
		logline(nt, regions)
	} else if (nt == "Homepage") {
		homepage = sval("url"); important = 1
		logline(nt, homepage)
	} else if (nt == "Exiting") {
		tunnels = 0; connected_since = 0; important = 1
		logline(nt, "")
	} else if (nt == "ConnectingServer") {
		attempts++
		dirty = 1
		logline(nt, sval("region") " " sval("protocol"))
	} else if (nt == "CandidateServers") {
		# how many servers psiphon actually has to try; 0 means the server
		# list was never obtained (bootstrap blocked)
		v = nval("count"); if (v >= 0) candidates = v
		important = 1
		logline(nt, "count=" candidates " region=" sval("region"))
	} else if (nt == "RemoteServerListResourceDownloaded") {
		serverlist = 1
		important = 1
		logline(nt, sval("url"))
	} else if (nt == "Alert" || nt == "Error" || nt == "Warning" || nt == "InternalError" || nt == "ServerAlert") {
		last_message = shorten(sval("message") sval("reason"))
		last_warning = nt ": " last_message
		important = 1
		logline(nt, last_message)
	} else if (nt == "Info" || nt == "UserLog") {
		logline(nt, sval("message"))
	} else if (nt == "SocksProxyPortInUse" || nt == "HttpProxyPortInUse") {
		last_message = nt " " nval("port")
		important = 1
		logline(nt, nval("port") "")
	}

	last_event = nt

	if (important || (dirty && systime() - last_write >= 2)) write_state()
}

END {
	tunnels = 0
	connected_since = 0
	attempts = 0
	last_event = "Stopped"
	write_state()
}
