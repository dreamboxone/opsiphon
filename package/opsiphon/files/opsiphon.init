#!/bin/sh /etc/rc.common
#
# SPDX-License-Identifier: GPL-3.0-only
# Copyright (C) 2026 dreamboxone <https://t.me/routekernel1>
# Part of opsiphon - Psiphon for OpenWrt - https://github.com/dreamboxone/opsiphon
#
# opsiphon - Psiphon circumvention client for OpenWrt

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/psiphon-tunnel-core
MKCONFIG=/usr/libexec/opsiphon-mkconfig
NOTICES=/usr/libexec/opsiphon-notices
CONFIG_JSON=/var/etc/opsiphon.json
STATE_DIR=/var/run/opsiphon
LOG_DIR=/var/log/opsiphon

sync_autostart() {
	local autostart
	config_get_bool autostart config autostart 0
	# Only touch the rc.d symlinks when invoked as /etc/init.d/opsiphon. At
	# boot this runs as /etc/rc.d/S95opsiphon, and rc.common's enable() then
	# builds a dangling K10S95opsiphon -> ../init.d/S95opsiphon link, because
	# it only strips a K-prefix from the K name.
	case "$(basename "${initscript:-opsiphon}")" in
		opsiphon) ;;
		*) return 0 ;;
	esac
	if [ "$autostart" = "1" ]; then
		enable
	else
		disable
	fi
}

start_service() {
	local enabled data_dir listen_interface server_list_file cmd pw

	config_load opsiphon
	sync_autostart

	config_get_bool enabled config enabled 0
	if [ "$enabled" != "1" ]; then
		logger -t opsiphon "not starting: disabled (press Connect in LuCI)"
		return 0
	fi

	if [ ! -x "$PROG" ]; then
		logger -t opsiphon "core binary $PROG is missing"
		return 1
	fi

	config_get data_dir config data_dir '/etc/opsiphon/data'
	config_get listen_interface config listen_interface ''
	config_get server_list_file config server_list_file ''

	mkdir -p "$data_dir" "$STATE_DIR" "$LOG_DIR" /var/etc
	: > "$LOG_DIR/notices.log"

	if ! "$MKCONFIG" > "$CONFIG_JSON"; then
		logger -t opsiphon "failed to generate $CONFIG_JSON"
		return 1
	fi
	chmod 600 "$CONFIG_JSON"

	cmd="$PROG -config $CONFIG_JSON -dataRootDirectory $data_dir"
	[ -n "$listen_interface" ] && cmd="$cmd -listenInterface $listen_interface"
	# embedded server entries: lets the tunnel start without first fetching
	# the remote server list, which is what breaks under heavy filtering
	if [ -n "$server_list_file" ] && [ -s "$server_list_file" ]; then
		cmd="$cmd -serverList $server_list_file"
	fi

	procd_open_instance opsiphon
	# psiphon writes its notice stream to stderr; it is piped into the state
	# collector so the GUI always has live status without touching flash.
	procd_set_param command /bin/sh -c "exec $cmd 2>&1 | exec $NOTICES"
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param pidfile /var/run/opsiphon.pid
	procd_close_instance

	# keep the PassWall2 node in sync with our proxy port, if asked to
	local pw
	config_get_bool pw config passwall_integration 1
	if [ "$pw" = "1" ] && [ -x /usr/libexec/opsiphon-passwall ]; then
		# Fully detached, and with fd 1000 closed. That fd is the procd
		# lock rc.common holds while this runs; PassWall2 restarts from
		# here and every daemon it spawns - xray included - would inherit
		# the lock and hold it for as long as it lives. Anything that ran
		# /etc/init.d/opsiphon afterwards would then block forever.
		( /usr/libexec/opsiphon-passwall sync </dev/null >/dev/null 2>&1 1000>&- & ) &
	fi
}

stop_service() {
	# procd terminates the wrapper shell; make sure the core and the notice
	# collector go with it (the collector exits on EOF once the core is gone)
	killall -q psiphon-tunnel-core 2>/dev/null
	rm -f "$STATE_DIR/state" "$CONFIG_JSON"
}

reload_service() {
	config_load opsiphon
	sync_autostart
	restart
}

service_triggers() {
	procd_add_reload_trigger "opsiphon"
}

status_service() {
	/usr/libexec/opsiphon-stat
}
