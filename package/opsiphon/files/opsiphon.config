#
config opsiphon 'config'
	# Tunnel state. 0 after installation: nothing runs until you press
	# Connect in LuCI (or run '/etc/init.d/opsiphon start' after setting
	# this to 1). Connect / Disconnect in LuCI toggle this option.
	option enabled '0'
	# Re-open the tunnel automatically after a reboot (only has an effect
	# while 'enabled' is 1)
	option autostart '1'
	# Egress country (ISO 3166-1 alpha-2), empty = auto / best performer
	option region ''
	# Local proxies. 0 disables that proxy.
	option socks_port '1080'
	option http_port '8080'
	# Bind local proxies to this interface (empty = 127.0.0.1 only,
	# e.g. 'br-lan' to let LAN clients use the proxy directly)
	option listen_interface ''
	# Collect traffic statistics (EmitBytesTransferred)
	option stats '1'
	# Persistent datastore (server entries). Put it on external storage
	# (e.g. /mnt/sda1/opsiphon) to reduce flash writes.
	option data_dir '/etc/opsiphon/data'
	# Tunnel establishment timeout in seconds, 0 = psiphon default
	option establish_timeout '0'
	# Emit Psiphon's diagnostic notices (warnings, errors, candidate server
	# counts). Keep this on: it is what explains a failed connection.
	option diagnostics '1'
	# Send the tunnel itself through another proxy first, e.g.
	# 'socks5://127.0.0.1:10808' or 'http://127.0.0.1:8118'. Useful where the
	# Psiphon bootstrap is blocked but another proxy still works.
	option upstream_proxy ''
	# Optional file with embedded Psiphon server entries, used to start
	# without downloading the remote server list first.
	option server_list_file ''

	# --- PassWall2 integration and Iran routing rules -------------------
	# Create/refresh a SOCKS node in PassWall2 automatically when the tunnel
	# starts (only if PassWall2 is installed). It is never activated on its
	# own - use the button in LuCI, or pick it in PassWall2.
	option passwall_integration '1'
	# Routing data files used by a proxy manager (Xray/sing-box) to keep
	# Iranian traffic out of the tunnel.
	option geoip_url 'https://github.com/chocolate4u/Iran-v2ray-rules/releases/latest/download/geoip.dat'
	option geosite_url 'https://github.com/chocolate4u/Iran-v2ray-rules/releases/latest/download/geosite.dat'
	# Where those files are installed when PassWall2 is not present
	option asset_dir '/usr/share/v2ray/'
	# Restrict tunnel protocols (empty/absent = all). Set from the LuCI
	# Advanced tab, or as a UCI list, e.g.:
	#   list protocols 'OSSH'
	#   list protocols 'QUIC-OSSH'

	# --- Psiphon network identity (Advanced tab in LuCI) ---------------
	# These identify the client to the Psiphon network and tell it where to
	# fetch its server list from. The defaults are the public community
	# values published with the open source psiphon-tunnel-core sample
	# configuration. Only change them if Psiphon Inc. gave you your own
	# sponsor configuration.
	option sponsor_id 'FFFFFFFFFFFFFFFF'
	option propagation_id 'FFFFFFFFFFFFFFFF'
	option server_list_url 'https://s3.amazonaws.com/psiphon/web/mjr4-p23r-puwl/server_list_compressed'
	# Bootstrap mirrors, tried alongside the URL above. The first entry is the
	# copy kept in this project's repository by .github/workflows/
	# mirror-bootstrap.yml, for networks where the original is blocked. Safe
	# by construction: the list is RSA signed and verified with the key below,
	# so a mirror can only serve an older copy, never a forged one.
	list server_list_urls 'https://raw.githubusercontent.com/dreamboxone/opsiphon/master/mirror/server_list_compressed'
	list server_list_urls 'https://s3.amazonaws.com/psiphon/web/mjr4-p23r-puwl/server_list_compressed'
	# option server_list_key '...'   # empty = built-in community key
	# Key Psiphon uses to verify individual server entries from its DSL
	# discovery service. It is not published - official clients carry it
	# baked in - so leaving this empty turns the DSL fetcher off instead of
	# letting every fetch fail with "missing public key". The tunnel does
	# not need it; the server list above is what bootstraps a fresh client.
	# option server_entry_key '...'  # empty = DSL fetcher disabled
