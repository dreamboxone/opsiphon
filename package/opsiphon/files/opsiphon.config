config opsiphon 'config'
	# Master switch (Connect / Disconnect in LuCI)
	option enabled '1'
	# Start automatically when the router boots
	option autostart '1'
	# Egress country (ISO 3166-1 alpha-2), empty = auto / best performer
	option region ''
	# Local proxies
	option socks_port '1080'
	option http_port '8080'
	# Bind local proxies to this interface (empty = 127.0.0.1 only,
	# e.g. 'br-lan' to let LAN clients use the proxy directly)
	option listen_interface ''
	# Collect traffic statistics (EmitBytesTransferred)
	option stats '1'
	# Persistent datastore (server entries). Put it on external storage
	# (e.g. /mnt/sda1/opsiphon) to reduce flash writes.
	option data_dir '/etc/opsiphon/data'
	# Tunnel establishment timeout in seconds, 0 = psiphon default
	option establish_timeout '0'
	# Restrict tunnel protocols (empty/absent = all). Set from the LuCI
	# Advanced tab, or as a UCI list, e.g.:
	#   list protocols 'OSSH'
	#   list protocols 'QUIC-OSSH'

config psiphon 'network'
	# Open (community) Psiphon configuration. Replace with values provided
	# by Psiphon Inc. if you have your own sponsor configuration.
	option sponsor_id 'FFFFFFFFFFFFFFFF'
	option propagation_id 'FFFFFFFFFFFFFFFF'
	option server_list_url 'https://s3.amazonaws.com/psiphon/web/mjr4-p23r-puwl/server_list_compressed'
