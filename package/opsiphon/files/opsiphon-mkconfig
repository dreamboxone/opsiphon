# opsiphon-mkconfig - generate a psiphon-tunnel-core config file from UCI

. /lib/functions.sh

# Public signature key for the community remote server list. This is the key
# published with the open source psiphon-tunnel-core sample configuration.
DEFAULT_SERVER_LIST_KEY=""

json_escape() {
	# escape backslash, double quote and control characters
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\000-\037'
}

PROTOCOLS=""
add_protocol() {
	local p="$1"
	[ -n "$p" ] || return 0
	if [ -n "$PROTOCOLS" ]; then
		PROTOCOLS="$PROTOCOLS, \"$(json_escape "$p")\""
	else
		PROTOCOLS="\"$(json_escape "$p")\""
	fi
}

config_load opsiphon

config_get region           config region ''
config_get socks_port       config socks_port '1080'
config_get http_port        config http_port '8080'
config_get data_dir         config data_dir '/etc/opsiphon/data'
config_get establish_timeout config establish_timeout '0'
config_get_bool stats       config stats 1
config_get_bool diagnostics config diagnostics 1
config_get upstream_proxy   config upstream_proxy ''

# protocols may be stored either as a UCI list (CLI users) or as a single
# space separated option (that is what LuCI's MultiValue writes)
config_list_foreach config protocols add_protocol
if [ -z "$PROTOCOLS" ]; then
	config_get protocols_opt config protocols ''
	for p in $protocols_opt; do add_protocol "$p"; done
fi

# Psiphon network identity. It lives in the main 'config' section; the
# separate 'network' section of opsiphon 1.0.0-r1 is still honoured so that
# existing installations keep working after an upgrade.
config_get l_sponsor_id      network sponsor_id ''
config_get l_propagation_id  network propagation_id ''
config_get l_server_list_url network server_list_url ''
config_get l_server_list_key network server_list_key ''

config_get sponsor_id       config sponsor_id "${l_sponsor_id:-FFFFFFFFFFFFFFFF}"
config_get propagation_id   config propagation_id "${l_propagation_id:-FFFFFFFFFFFFFFFF}"
config_get server_list_url  config server_list_url "${l_server_list_url:-https://s3.amazonaws.com/psiphon/web/mjr4-p23r-puwl/server_list_compressed}"
config_get server_list_key  config server_list_key "${l_server_list_key:-$DEFAULT_SERVER_LIST_KEY}"

[ -n "$server_list_key" ] || server_list_key="$DEFAULT_SERVER_LIST_KEY"

printf '{\n'
printf '  "PropagationChannelId": "%s",\n' "$(json_escape "$propagation_id")"
printf '  "SponsorId": "%s",\n'            "$(json_escape "$sponsor_id")"
printf '  "RemoteServerListUrl": "%s",\n'  "$(json_escape "$server_list_url")"
printf '  "RemoteServerListDownloadFilename": "remote_server_list",\n'
printf '  "RemoteServerListSignaturePublicKey": "%s",\n' "$(json_escape "$server_list_key")"
printf '  "DataRootDirectory": "%s",\n'    "$(json_escape "$data_dir")"
printf '  "LocalSocksProxyPort": %d,\n'    "${socks_port:-1080}"
printf '  "LocalHttpProxyPort": %d,\n'     "${http_port:-8080}"

[ -n "$region" ] && printf '  "EgressRegion": "%s",\n' "$(json_escape "$region")"
[ -n "$PROTOCOLS" ] && printf '  "LimitTunnelProtocols": [%s],\n' "$PROTOCOLS"
[ "${establish_timeout:-0}" -gt 0 ] 2>/dev/null && \
	printf '  "EstablishTunnelTimeoutSeconds": %d,\n' "$establish_timeout"

[ "${socks_port:-1080}" -eq 0 ] 2>/dev/null && printf '  "DisableLocalSocksProxy": true,\n'
[ "${http_port:-8080}" -eq 0 ]  2>/dev/null && printf '  "DisableLocalHTTPProxy": true,\n'

if [ "$stats" = "1" ]; then
	printf '  "EmitBytesTransferred": true,\n'
fi

# Route the tunnel itself through another proxy first. This is what makes
# bootstrapping possible where Psiphon's own servers are unreachable.
[ -n "$upstream_proxy" ] && \
	printf '  "UpstreamProxyURL": "%s",\n' "$(json_escape "$upstream_proxy")"

# Diagnostic notices carry the Warning / Error / CandidateServers messages that
# explain *why* a tunnel is not establishing - without them a blocked client
# just sits at "Connecting..." with nothing to show. Keep this last so the JSON
# object always ends without a trailing comma.
if [ "$diagnostics" = "1" ]; then
	printf '  "EmitDiagnosticNotices": true\n'
else
	printf '  "EmitDiagnosticNotices": false\n'
fi
printf '}\n'
