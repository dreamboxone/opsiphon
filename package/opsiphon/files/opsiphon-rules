#
# opsiphon-rules - download / update the Iran routing data files
#
#   opsiphon-rules update    fetch geoip.dat + geosite.dat
#   opsiphon-rules status    JSON with size and age of the installed files
#
# The files are the Iran-v2ray-rules builds, which carry the geoip:ir and
# geosite:ir categories. They are consumed by Xray / sing-box - that is, by a
# proxy manager such as PassWall2 - not by Psiphon itself, so they are what
# makes "keep Iranian traffic out of the tunnel" possible.

GEOIP_URL_DEFAULT="https://github.com/chocolate4u/Iran-v2ray-rules/releases/latest/download/geoip.dat"
GEOSITE_URL_DEFAULT="https://github.com/chocolate4u/Iran-v2ray-rules/releases/latest/download/geosite.dat"

MIN_SIZE=102400   # a truncated or error page must never replace a good file
JOB=/var/run/opsiphon/rules.job

job() {
	# state of the running / last download, polled by the LuCI page
	mkdir -p "$(dirname "$JOB")" 2>/dev/null
	printf '%s|%s|%s\n' "$1" "$(date +%s)" "$2" > "$JOB"
}

asset_dir() {
	local d
	d="$(uci -q get passwall2.@global_rules[0].v2ray_location_asset)"
	[ -n "$d" ] || d="$(uci -q get opsiphon.config.asset_dir)"
	[ -n "$d" ] || d="/usr/share/v2ray/"
	echo "${d%/}"
}

fetch() {
	# $1 url, $2 destination
	local url="$1" out="$2" tmp="$2.opsiphon.tmp" rc=1

	rm -f "$tmp"
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -T 30 -O "$tmp" "$url" && rc=0
	fi
	[ "$rc" = 0 ] || if command -v curl >/dev/null 2>&1; then
		curl -sSL --fail --connect-timeout 20 --max-time 300 -o "$tmp" "$url" && rc=0
	fi
	[ "$rc" = 0 ] || if command -v wget >/dev/null 2>&1; then
		wget -q -T 30 -O "$tmp" "$url" && rc=0
	fi

	if [ "$rc" != 0 ] || [ ! -s "$tmp" ]; then
		rm -f "$tmp"
		echo "download failed: $url" >&2
		return 1
	fi

	local size
	size=$(wc -c < "$tmp" 2>/dev/null || echo 0)
	if [ "$size" -lt "$MIN_SIZE" ]; then
		rm -f "$tmp"
		echo "downloaded file too small ($size bytes): $url" >&2
		return 1
	fi

	mv -f "$tmp" "$out" || return 1
	chmod 0644 "$out"
	echo "updated $out ($size bytes)"
	return 0
}

update() {
	local dir geoip_url geosite_url rc=0
	job running "starting"
	dir="$(asset_dir)"
	mkdir -p "$dir" || { job error "cannot create $dir"; echo "cannot create $dir" >&2; exit 1; }

	geoip_url="$(uci -q get opsiphon.config.geoip_url)"
	geosite_url="$(uci -q get opsiphon.config.geosite_url)"
	[ -n "$geoip_url" ] || geoip_url="$GEOIP_URL_DEFAULT"
	[ -n "$geosite_url" ] || geosite_url="$GEOSITE_URL_DEFAULT"

	echo "asset directory: $dir"
	job running "downloading geoip.dat"
	fetch "$geoip_url" "$dir/geoip.dat" || rc=1
	job running "downloading geosite.dat"
	fetch "$geosite_url" "$dir/geosite.dat" || rc=1

	# Xray and sing-box may look in their own directory; keep them in sync
	local other
	for other in /usr/share/xray /usr/share/sing-box; do
		[ -d "$other" ] && [ "$other" != "$dir" ] && {
			[ -f "$dir/geoip.dat" ] && cp -f "$dir/geoip.dat" "$other/geoip.dat" 2>/dev/null
			[ -f "$dir/geosite.dat" ] && cp -f "$dir/geosite.dat" "$other/geosite.dat" 2>/dev/null
			echo "mirrored to $other"
		}
	done

	if [ "$rc" = 0 ]; then
		job ok "files updated"
		# a proxy manager has to reload to pick up the new data files
		if [ -x /etc/init.d/passwall2 ]; then
			( /etc/init.d/passwall2 restart </dev/null >/dev/null 2>&1 & ) &
		fi
		echo "done"
	else
		job error "download failed - check the router's internet access"
	fi
	return $rc
}

file_json() {
	# $1 label, $2 path
	local size=0 mtime=0
	[ -f "$2" ] && {
		size=$(wc -c < "$2" 2>/dev/null || echo 0)
		mtime=$(date -r "$2" +%s 2>/dev/null || echo 0)
	}
	printf '"%s":{"path":"%s","size":%d,"mtime":%d}' "$1" "$2" "${size:-0}" "${mtime:-0}"
}

status() {
	local dir jstate jtime jmsg
	dir="$(asset_dir)"

	if [ -f "$JOB" ]; then
		jstate="$(cut -d'|' -f1 "$JOB" 2>/dev/null)"
		jtime="$(cut -d'|' -f2 "$JOB" 2>/dev/null)"
		jmsg="$(cut -d'|' -f3- "$JOB" 2>/dev/null)"
	fi

	printf '{"job":{"state":"%s","time":%d,"message":"%s"},' \
		"${jstate:-idle}" "${jtime:-0}" "${jmsg:-}"
	printf '"dir":"%s",' "$dir"
	file_json geoip "$dir/geoip.dat"
	printf ','
	file_json geosite "$dir/geosite.dat"
	printf ',"now":%d}\n' "$(date +%s)"
}

case "$1" in
	update) update ;;
	status) status ;;
	*) echo "usage: $0 update | status" >&2; exit 1 ;;
esac
